# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon
# Clé service role : serveur uniquement, contourne la RLS.
# Ne jamais l'exposer au navigateur (NEXT_PUBLIC_ la rendrait publique).
#
# OPTIONNELLE en local : l'application démarre et fonctionne sans elle. Elle ne
# sert qu'à /api/register (créer un compte), /api/invitations/accept et
# /api/stripe/* — qui répondent 503 sans elle. Voir SECURITY.md.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ── Application ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...

# ── Sentry ──────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Jeton personnel Supabase (migrations par scripts/supabase-sql.mjs)
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
